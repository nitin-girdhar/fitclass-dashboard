# ============================================================================
#  FitClass CRM — environment template
#  Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ============================================================================

# ── Auth provider switch ─────────────────────────────────────────────────────
# "local"    → PostgreSQL-native auth (new path, recommended)
# "supabase" → legacy Supabase auth (kept for migration period)
AUTH_PROVIDER=local

# ── Database provider switch ─────────────────────────────────────────────────
# "local"    → self-hosted PostgreSQL (dev/prod with own infra)
# "supabase" → Supabase-hosted PostgreSQL (uses Supabase connection strings)
DB_PROVIDER=local

# ── PostgreSQL connection strings ────────────────────────────────────────────
# DATABASE_URL        → app_user role (single-org CRM operations)
#                       In production: point to PgBouncer in transaction mode
# DATABASE_URL_TENANT → tenant_admin role (cross-org tenant dashboard)
# DATABASE_URL_SERVICE → service_role (migrations, seed, admin tasks)
#                        In production: connect DIRECTLY to PostgreSQL primary,
#                        bypassing PgBouncer (service_role uses named prepared
#                        statements that are incompatible with transaction mode)
# DATABASE_URL_ANALYTICS → analytics_svc BYPASSRLS (read-only replica)

DATABASE_URL=postgres://lead_svc:replace_me@localhost:5432/crm_db
DATABASE_URL_TENANT=postgres://tenant_dash_svc:replace_me@localhost:5432/crm_db
DATABASE_URL_SERVICE=postgres://service_role:replace_me@localhost:5432/crm_db
DATABASE_URL_ANALYTICS=postgres://analytics_svc:replace_me@localhost:5432/crm_db

# ── Connection pool tuning ───────────────────────────────────────────────────
PG_MAX=10
PG_IDLE_TIMEOUT=30

# ── JWT / session ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Password hashing ─────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (legacy — only used when AUTH_PROVIDER=supabase) ────────────────
# Any var prefixed NEXT_PUBLIC_ is inlined into the client bundle at build time
# and is visible to anyone. The Supabase URL + anon key are designed to be
# public; access is constrained by RLS policies on the database side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY bypasses ALL Row Level Security — full admin
# access. Leaking it = full data breach. Used only by supabaseAdmin client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Seed (CLI only — `npm run db:seed-admin`) ────────────────────────────────
# Used once to create the first admin user. Idempotent on re-run.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=FitClass Admin
