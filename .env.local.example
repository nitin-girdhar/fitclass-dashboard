# ============================================================================
#  FitClass CRM — environment template
#  Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# ============================================================================

# ── PostgreSQL connection strings ────────────────────────────────────────────
# DATABASE_URL        → app_user role (single-org CRM operations)
#                       In production: point to PgBouncer in transaction mode
# DATABASE_URL_TENANT → tenant_admin role (cross-org tenant dashboard)
# DATABASE_URL_SERVICE → crm_service (migrations, seed, admin tasks, BYPASSRLS)
#                        In production: connect DIRECTLY to PostgreSQL primary,
#                        bypassing PgBouncer (crm_service uses named prepared
#                        statements incompatible with transaction mode)
# DATABASE_URL_ANALYTICS → analytics_svc BYPASSRLS (read-only replica)

DATABASE_URL=postgres://lead_svc:replace_me@localhost:5432/crm_db
DATABASE_URL_TENANT=postgres://tenant_dash_svc:replace_me@localhost:5432/crm_db
DATABASE_URL_SERVICE=postgres://crm_service:replace_me@localhost:5432/crm_db
DATABASE_URL_ANALYTICS=postgres://analytics_svc:replace_me@localhost:5432/crm_db

# ── Connection pool tuning ───────────────────────────────────────────────────
PG_MAX=10
PG_IDLE_TIMEOUT=30

# ── SSL (production only) ────────────────────────────────────────────────────
# In production, SSL is required automatically. To use a custom CA certificate
# (e.g. self-signed or private CA), set DB_SSL_CA to the path of the PEM file.
# DB_SSL_CA=/etc/ssl/certs/my-ca.pem

# ── JWT / session ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Password hashing ─────────────────────────────────────────────────────────
# Use 10 rounds locally (faster); use 12 in production
BCRYPT_ROUNDS=12

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Seed (CLI only — `npm run db:seed-admin`) ────────────────────────────────
# SEED_ORG_ID must be the UUID of an existing organisation. Create the org
# (and its parent tenant) before running the seed script.
SEED_ORG_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=FitClass Admin
